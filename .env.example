# Copier ce fichier vers .env et renseigner les valeurs.
# .env est ignore par git — ne jamais le committer.
#
# Seules les variables prefixees VITE_ sont exposees au navigateur.
# Les secrets des Edge Functions se configurent cote Supabase :
#   supabase secrets set NOM=valeur

# --- Supabase (valeurs publiques, protegees par les RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Sentry (optionnel — monitoring desactive si vide) ---
VITE_SENTRY_DSN=

# --- Web Push (optionnel — bouton push desactive si vide) ---
# La cle privee VAPID va dans les secrets Supabase, pas ici.
VITE_VAPID_PUBLIC_KEY=
